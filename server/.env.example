# --- Server ---
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# --- URLs ---
# Origin where this API is reachable (used in emailed links)
PUBLIC_BASE_URL=http://localhost:8787
# Origin of the static site (used as default `next` redirect after magic-link verify)
SITE_URL=http://localhost:3000

# --- Database ---
# File path for the SQLite database. Use ":memory:" for tests.
DB_PATH=./data/mail.db

# --- Email ---
# When unset (or MAIL_TRANSPORT=noop) emails are logged to stdout instead of sent.
# Set MAIL_TRANSPORT=resend in production.
MAIL_TRANSPORT=noop
RESEND_API_KEY=
MAIL_FROM=No Gravity <hello@nxgrxvity.com>

# --- Auth / sessions ---
# 32+ random bytes hex. Used to sign nothing currently, but reserved for HMAC of stateless tokens.
SESSION_SECRET=change-me-to-a-long-random-hex-string
# Comma-separated allowed CORS origins for the browser-facing API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin ---
# First time this email signs in via magic link, it is auto-promoted to is_admin=1.
INITIAL_ADMIN_EMAIL=
